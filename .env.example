# Public site settings. Keep these empty until the values are verified.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Set to true only after the public domain is verified and publishing is approved.
BOH_INDEXING_ENABLED=false

# Contact form delivery via Resend (server-side secrets — set in Vercel, never commit real values).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional verified sender, e.g. "BOH ERP <hello@your-domain.com>". Defaults to Resend's test sender.
CONTACT_FROM_EMAIL=

# Impressum / legal identity (shown on /impressum and /privacy).
NEXT_PUBLIC_LEGAL_COMPANY=
NEXT_PUBLIC_LEGAL_FORM=
NEXT_PUBLIC_LEGAL_REPRESENTATIVE=
NEXT_PUBLIC_LEGAL_STREET=
NEXT_PUBLIC_LEGAL_POSTAL_CITY=
NEXT_PUBLIC_LEGAL_COUNTRY=Germany
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_PHONE=
NEXT_PUBLIC_LEGAL_REGISTER=
NEXT_PUBLIC_LEGAL_VAT_ID=

# Optional: Gmail in the demo inbox (Google Cloud OAuth client ID, type "Web application",
# authorised JavaScript origin = the site URL). Without it the demo uses the sample inbox.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
